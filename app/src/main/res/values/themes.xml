<resources>
    <style name="Theme.MusicPlayer" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/juke_primary</item>
        <item name="android:navigationBarColor">@color/juke_navigation_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.MusicPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/juke_brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/juke_splash_empty</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.MusicPlayer</item>
    </style>
</resources>
